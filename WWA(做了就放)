def clear_screen():
    os.system("cls" if os.name == "nt" else "clear")


def get_validated_input(prompt, is_integer=False, allow_zero=True):

    while True:
        try:
            user_input = input(prompt)
            val = int(user_input) if is_integer else float(user_input)

            if allow_zero:
                if val < 0:
                    print("  Invalid! Value must be 0 or positive.")
                    continue
            else:
                if val <= 0:
                    print("  Invalid! Value must be positive and greater than 0.")
                    continue

            return val

        except ValueError:
            print("  Invalid! Please enter a numeric value.")


# ---------------------------------------------------------
# Confirm and edit demand function
# ---------------------------------------------------------

def input_demands(n):

    demands = []

    # First-time demand input
    print("\nEnter demand for each period")
    print("-" * 40)

    for i in range(1, n + 1):
        d = get_validated_input(
            f"Enter demand for period {i}: ",
            allow_zero=True
        )
        demands.append(d)

    # Confirmation / editing loop
    while True:

        print("\n" + "=" * 40)
        print("CONFIRM DEMAND")
        print("=" * 40)

        for i in range(n):
            print(f"Period {i + 1}: {demands[i]:.1f}")

        print("=" * 40)
        print("1. Confirm")
        print("2. Edit a demand")
        print("3. Re-enter all demands")

        while True:
            choice = input("\nEnter your choice (1/2/3): ")

            if choice == "1":
                return demands

            elif choice == "2":
                # Keep asking until a valid period is entered
                while True:
                    period = get_validated_input(f"Enter period to edit (1-{n}): ",is_integer=True,allow_zero=False)

                    if 1 <= period <= n:
                        break
                    print("Invalid period! Please enter a valid period.")

                # Ask for new demand AFTER a valid period is entered
                new_demand = get_validated_input(f"Enter new demand for period {period}: ",allow_zero=True)

                # Update the selected demand
                demands[period - 1] = new_demand

                # Show updated demand
                print("\n" + "-" * 40)
                print("UPDATED DEMAND")
                print("-" * 40)
                
                for i in range(n):
                    print(f"Period {i + 1}: {demands[i]:.1f}")
        
                print("-" * 40)

                # Return to confirmation menu
                break

            elif choice == "3":

                print("\nEnter demand for each period")
                print("-" * 40)

                demands = []

                for i in range(1, n + 1):
                    d = get_validated_input(
                        f"Enter demand for period {i}: ",
                        allow_zero=True
                    )
                    demands.append(d)

                # Stay in confirmation loop
                break

            else:
                print("  Invalid choice! Please enter 1, 2, or 3.")


# ---------------------------------------------------------
# Wagner-Whitin Algorithm
# ---------------------------------------------------------

def wagner_whitin_backward(n, demands, s, h, v):

    clear_screen()

    print("--- Wagner-Whitin Algorithm ---")
    
    # -----------------------------------------------------
    # 1. User Inputs
    # -----------------------------------------------------

    
  
    # -----------------------------------------------------
    # 1. Initialize DP tables
    # -----------------------------------------------------
    # f[i] will store the min cost to satisfy demand from period i to n
    # We use n+2 size to handle the "base case" at the end easily

    f = [0.0] * (n + 2) 

    next_order_end = [0] * (n + 1) # Stores where the order starting at 'i' ends

    # Store cost components for optimal solution
    setup_costs = [0.0] * (n + 1)
    holding_costs = [0.0] * (n + 1)
    variable_costs = [0.0] * (n + 1)

    # -----------------------------------------------------
    # 2. Backward DP Calculation
    # -----------------------------------------------------
    # Start from the last period and move to the first

    for i in range(n, 0, -1):

        min_cost = float('inf')
        best_k = -1

        # Test placing an order in period i that covers demand up to period k
        for k in range(i, n + 1):

            # Calculate demand and costs for this specific lot (i to k)
            current_lot_demand = sum(demands[i - 1:k])

            # Holding cost: items for period 'm' are held for (m - i) periods
            current_holding_cost = 0

            for m in range(i, k + 1):

                current_holding_cost += ((m - i)* demands[m - 1]* h)

            # Variable cost
            current_variable_cost = (current_lot_demand * v)

            # Total cost = Setup + Holding + Variable + (Optimal cost from k+1 to end period)

            total_cost = (s + current_holding_cost + current_variable_cost + f[k + 1])

            if total_cost < min_cost:
                min_cost = total_cost
                best_k = k

        f[i] = min_cost
        next_order_end[i] = best_k

    # -----------------------------------------------------
    # 3. Forward Backtracking
    # -----------------------------------------------------
    # Start at period 1 and follow the pointers forward

    order_schedule = [0.0] * n
    order_end_period = [0] * n

    curr = 1

    while curr <= n:

        end_period = next_order_end[curr]

        # Calculate the size of the order placed at 'curr'
        qty = sum(demands[curr - 1:end_period])

        order_schedule[curr - 1] = qty
        order_end_period[curr - 1] = end_period

        # Jump to the period after this lot ends
        curr = end_period + 1

    # -----------------------------------------------------
    # 4. Calculate cost breakdown
    # -----------------------------------------------------

    total_setup_cost = 0
    total_holding_cost = 0
    total_variable_cost = 0

    for i in range(n):

        if order_schedule[i] > 0:

            total_setup_cost += s
            total_variable_cost += (order_schedule[i] * v)

            end_period = order_end_period[i]

            for m in range(i + 1, end_period):

                total_holding_cost += ((m - i)* demands[m]* h)

    total_cost = (total_setup_cost + total_holding_cost + total_variable_cost)
    
    return {
        "n": n,
        "demands": demands,
        "setup_cost": s,
        "holding_cost": h,
        "variable_cost": v,
        "order_schedule": order_schedule,
        "order_end_period": order_end_period,
        "total_setup_cost": total_setup_cost,
        "total_holding_cost": total_holding_cost,
        "total_variable_cost": total_variable_cost,
        "total_cost": total_cost
    }

# =========================================================
# FILE MANAGEMENT
# =========================================================

class FileManager:

    # =====================================================
    # WRITE INPUT FILE
    # =====================================================

    @staticmethod
    def write_input(n, demands, s, h, v):

        filename = filedialog.asksaveasfilename(
            title="Save Input Data",
            defaultextension=".csv",
            filetypes= [("CSV Files", "*.csv"), ("All Files", "*.*")]
        )

        if not filename:
            return False

        with open(filename, "w", newline="", encoding="utf-8-sig") as file:

            writer = csv.writer(file)

            # File title
            writer.writerow(["WAGNER-WHITIN INPUT DATA"])
            writer.writerow([])

            # Cost information
            writer.writerow(["Parameter", "Value"])
            writer.writerow(["Number of Years", n])
            writer.writerow(["Setup Cost", s])
            writer.writerow(["Holding Cost", h])
            writer.writerow(["Variable Cost", v])
            writer.writerow([])

            # Demand information
            writer.writerow(["Year", "Demand"])
            for i in range(n):

                writer.writerow([
                    i + 1,
                    demands[i]
                ])

        return True

    # =====================================================
    # READ INPUT FILE
    # =====================================================

    @staticmethod
    def read_input():

        filename = filedialog.askopenfilename(
            title="Open Input Data",
            filetypes=[("CSV Files", "*.csv"), ("All Files", "*.*")]
        )

        if not filename:
            return None

        with open(filename, "r", newline="", encoding="utf-8-sig") as file:

            rows = list(csv.reader(file))

        try:
            # Read number of years
            n = int(float(rows[3][1]))

            # Read costs
            s = float(rows[4][1])
            h = float(rows[5][1])
            v = float(rows[6][1])

            # Read demand
            demands = []

            for row in rows[9:]:

                if len(row) >= 2:

                    if row[0].strip():

                        demands.append(float(row[1]))

            # Check demand count
            if len(demands) != n:

                raise ValueError(
                    "The number of demand values "
                    "does not match the number of years."
                )

        except Exception as error:

            raise ValueError(f"Invalid input file:\n{error}")

        return (n, demands, s, h, v)

    # =====================================================
    # EXPORT RESULTS TO CSV
    # =====================================================

    @staticmethod
    def export_csv(results):

        if results is None:

            raise ValueError(
                "No calculation result available."
            )

        filename = filedialog.asksaveasfilename(
            title="Export Results to CSV",
            defaultextension=".csv",
            filetypes=[("CSV Files", "*.csv"), ("All Files", "*.*")]
        )

        if not filename:
            return False

        with open(filename, "w", newline="", encoding="utf-8-sig") as file:

            writer = csv.writer(file)

            # Title
            writer.writerow(["WAGNER-WHITIN OPTIMAL SOLUTION"])
            writer.writerow([])
            
            # Ordering plan
            writer.writerow(["Year", "Demand", "Order Quantity", "Order Covers Until"])

            for i in range(results["n"]):

                if (results["order_schedule"][i] > 0):

                    order_quantity = (results["order_schedule"][i])
                    covers_until = (results["order_end_period"][i])

                else:

                    order_quantity = 0
                    covers_until = "-"

                writer.writerow([i + 1, results["demands"][i], order_quantity, covers_until])
            
            writer.writerow([])

            # Cost breakdown
            writer.writerow(["COST BREAKDOWN"])
            writer.writerow(["Total Setup Cost", results["total_setup_cost"]])
            writer.writerow(["Total Holding Cost", results["total_holding_cost"]])
            writer.writerow(["Total Variable Cost", results["total_variable_cost"]])
            writer.writerow([])
            writer.writerow(["TOTAL OPTIMAL COST", results["total_cost"]])

        return True

    # =====================================================
    # EXPORT TEXT REPORT
    # =====================================================

    @staticmethod
    def export_report(results):

        if results is None:

            raise ValueError(
                "No calculation result available."
            )

        filename = filedialog.asksaveasfilename(
            title="Export WWA Report",
            defaultextension=".txt",
            filetypes=[("Text Files", "*.txt"), ("All Files", "*.*")]
        )

        if not filename:
            return False

        with open(filename, "w", encoding="utf-8") as file:

            # Report heading
            file.write("=" * 70 + "\n")
            file.write("WAGNER-WHITIN OPTIMAL SOLUTION\n")
            file.write("=" * 70 + "\n")
            file.write("Generated: " + datetime.now().strftime("%Y-%m-%d %H:%M:%S") + "\n\n")

            # Input information
            file.write("INPUT INFORMATION\n")
            file.write("-" * 70 + "\n")
            file.write(
                f"Number of Years : " 
                f"{results['n']}\n"
            )

            file.write(
                f"Setup Cost      : "
                f"RM {results['setup_cost']:.2f}\n"
            )

            file.write(
                f"Holding Cost    : "
                f"RM {results['holding_cost']:.2f}\n"
            )

            file.write(
                f"Variable Cost   : "
                f"RM {results['variable_cost']:.2f}\n\n"
            )

            # Demand
            file.write("DEMAND BY YEAR\n")
            file.write("-" * 70 + "\n")

            for i in range(results["n"]):

                file.write(
                    f"Year {i + 1:<3}: "
                    f"{results['demands'][i]:.2f}\n"
                )

            # Optimal ordering plan
            file.write("\nOPTIMAL ORDERING PLAN\n")
            file.write("-" * 70 + "\n")

            file.write(
                f"{'Year':<10}"
                f"{'Demand':<15}"
                f"{'Order Qty':<15}"
                f"{'Covers Until':<15}\n"
            )

            file.write("-" * 70 + "\n")

            for i in range(results["n"]):

                if (results["order_schedule"][i] > 0):

                    qty = (results["order_schedule"][i])
                    end = (results["order_end_period"][i])

                else:

                    qty = 0
                    end = "-"

                file.write(
                    f"{i + 1:<10}"
                    f"{results['demands'][i]:<15.2f}"
                    f"{qty:<15.2f}"
                    f"{str(end):<15}\n"
                )

            # Cost breakdown
            file.write("\nCOST BREAKDOWN\n")
            file.write("-" * 70 + "\n")

            file.write(
                f"Total Setup Cost   : "
                f"RM {results['total_setup_cost']:.2f}\n"
            )

            file.write(
                f"Total Holding Cost : "
                f"RM {results['total_holding_cost']:.2f}\n"
            )

            file.write(
                f"Total Variable Cost: "
                f"RM {results['total_variable_cost']:.2f}\n"
            )

            file.write("-" * 70 + "\n")

            file.write(
                f"TOTAL OPTIMAL COST : "
                f"RM {results['total_cost']:.2f}\n"
            )

            file.write("=" * 70 + "\n")

        return True


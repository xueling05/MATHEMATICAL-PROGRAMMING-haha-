            pady=5
        )


    # =====================================================
    # CREATE DEMAND INPUT FIELDS
    # =====================================================

    def create_demand_fields(self):

        # Remove old demand fields

        for widget in self.demand_frame.winfo_children():

            widget.destroy()

        self.demand_entries = []


        try:

            n = int(
                self.period_entry.get()
            )

            if n <= 0:

                raise ValueError

        except ValueError:

            messagebox.showerror(
                "Input Error",
                "Please enter a valid number of periods."
            )

            return


        # Create one entry for each period

        for i in range(n):

            ttk.Label(
                self.demand_frame,
                text=f"Period {i + 1}:"
            ).grid(
                row=i // 5,
                column=(i % 5) * 2,
                padx=5,
                pady=5
            )


            entry = ttk.Entry(
                self.demand_frame,
                width=12
            )

            entry.grid(
                row=i // 5,
                column=(i % 5) * 2 + 1,
                padx=5,
                pady=5
            )


            self.demand_entries.append(
                entry
            )


        self.status_label.config(
            text=f"Created demand fields for {n} periods."
        )


    # =====================================================
    # GET INPUT FROM GUI
    # =====================================================

    def get_inputs(self):

        try:

            n = int(
                self.period_entry.get()
            )

            if n <= 0:

                raise ValueError(
                    "Number of periods must be positive."
                )


            s = float(
                self.setup_entry.get()
            )

            h = float(
                self.holding_entry.get()
            )

            v = float(
                self.variable_entry.get()
            )


            if s <= 0 or h <= 0 or v <= 0:

                raise ValueError(
                    "Cost values must be greater than 0."
                )


            if len(
                self.demand_entries
            ) != n:

                raise ValueError(
                    "Please click 'Create Demand Fields' first."
                )


            demands = []


            for entry in self.demand_entries:

                demand = float(
                    entry.get()
                )

                if demand < 0:

                    raise ValueError(
                        "Demand cannot be negative."
                    )

                demands.append(
                    demand
                )


            return (
                n,
                demands,
                s,
                h,
                v
            )


        except ValueError as error:

            raise ValueError(
                f"Invalid input: {error}"
            )


    # =====================================================
    # CALCULATE
    # =====================================================

    def calculate(self):

        try:

            n, demands, s, h, v = (
                self.get_inputs()
            )


            # Run Wagner-Whitin calculation

            self.results = (
                wagner_whitin_backward(
                    n,
                    demands,
                    s,
                    h,
                    v
                )
            )


            # Display results in GUI

            self.display_results()


            self.status_label.config(
                text="Calculation completed successfully."
            )


        except Exception as error:

            messagebox.showerror(
                "Calculation Error",
                str(error)
            )


    # =====================================================
    # DISPLAY RESULTS
    # =====================================================

    def display_results(self):

        # Clear previous results

        for item in self.table.get_children():

            self.table.delete(
                item
            )


        # Add calculation results to table

        for i in range(
            self.results["n"]
        ):

            if (
                self.results["order_schedule"][i]
                > 0
            ):

                order_quantity = (
                    f"{self.results['order_schedule'][i]:.2f}"
                )

                covers_until = (
                    self.results["order_end_period"][i]
                )

            else:

                order_quantity = "-"

                covers_until = "-"


            self.table.insert(
                "",
                "end",
                values=(
                    i + 1,
                    f"{self.results['demands'][i]:.2f}",
                    order_quantity,
                    covers_until
                )
            )


        # Update total cost

        self.cost_label.config(
            text=(
                "Total Optimal Cost: "
                f"RM {self.results['total_cost']:,.2f}"
            )
        )


    # =====================================================
    # CLEAR
    # =====================================================

    def clear(self):

        self.period_entry.delete(
            0,
            tk.END
        )

        self.setup_entry.delete(
            0,
            tk.END
        )

        self.holding_entry.delete(
            0,
            tk.END
        )

        self.variable_entry.delete(
            0,
            tk.END
        )


        for widget in self.demand_frame.winfo_children():

            widget.destroy()


        self.demand_entries = []


        for item in self.table.get_children():

            self.table.delete(
                item
            )


        self.results = None


        self.cost_label.config(
            text="Total Optimal Cost: RM 0.00"
        )


        self.status_label.config(
            text="Ready."
        )


    # =====================================================
    # EXPORT CSV
    # =====================================================

    def export_csv(self):

        if self.results is None:

            messagebox.showwarning(
                "No Results",
                "Please calculate the solution first."
            )

            return


        try:

            success = FileManager.export_csv(
                self.results
            )


            if success:

                messagebox.showinfo(
                    "Success",
                    "Results exported successfully."
                )


        except Exception as error:

            messagebox.showerror(
                "Export Error",
                str(error)
            )


    # =====================================================
    # EXPORT REPORT
    # =====================================================

    def export_report(self):

        if self.results is None:

            messagebox.showwarning(
                "No Results",
                "Please calculate the solution first."
            )

            return


        try:

            success = FileManager.export_report(
                self.results
            )


            if success:

                messagebox.showinfo(
                    "Success",
                    "Report exported successfully."
                )


        except Exception as error:

            messagebox.showerror(
                "Export Error",
                str(error)
            )

